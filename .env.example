# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Database (A1) ----------------------------------------------------------
DATABASE_URL="file:./db/custom.db"

# --- Network boundary (S1) --------------------------------------------------
# Serves localhost only by default. Add extra allowed hosts only when behind
# an authenticated reverse proxy and after creating an owner account.
# BRAIN_ALLOWED_HOSTS="brain.home.lan"

# --- Project scanning (S2) --------------------------------------------------
# Scanning is DISABLED until BRAIN_SCAN_ROOTS is set (separate with ";").
# BRAIN_SCAN_ROOTS="/path/to/projects"

# --- Local PIN quick-unlock (S4) --------------------------------------------
# Minimum 6 characters; global lockout after 5 failures within 15 minutes.
# AUTH_LOCAL_PIN=""

# --- Vision OCR (S5) --------------------------------------------------------
# BRAIN_DISABLE_CLOUD_OCR="1"

# --- Query logging (S6) -----------------------------------------------------
# Keep disabled by default to avoid logging captured secrets/content.
# BRAIN_PRISMA_LOG_QUERIES="0"

# --- Realtime service (A3) & Caddy (A4/S7) ----------------------------------
# REALTIME_HOST="127.0.0.1"
# REALTIME_PORT="3003"
# CADDY_BIND="127.0.0.1"
